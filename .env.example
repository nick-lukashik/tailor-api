# Copy to .env with `pnpm env:local`. In Kubernetes variables come from the ConfigMap
# <svc>-config and the SealedSecret <svc>-secrets (envFrom), not from a file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=dev
# Port of the separate Prometheus listener (GET /metrics); 0 turns it off.
METRICS_PORT=9464
# Proxy hops in front of the service (0 locally, 1 behind one ingress); used for client IPs.
TRUST_PROXY_HOPS=0
# Delay before shutdown after SIGTERM so the load balancer drops the pod first (ms).
# 0 in Kubernetes: the pod's preStop sleep does that.
SHUTDOWN_DELAY_MS=0

# Secrets: no defaults in code. Values below match compose.yaml and are for local use only.
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# Access tokens of id-api: its JWKS (in the cluster http://id-api.prod.svc/.well-known/jwks.json),
# issuer and audience. Locally: id-api's own port.
ID_JWKS_URL=http://localhost:4100/.well-known/jwks.json
TOKEN_ISSUER=http://localhost:3100
TOKEN_AUDIENCE=nick-lukashik
# Who may use Tailor (D-112): comma-separated user ids of id-api. Everyone else signed in gets
# 403 NOT_INVITED; GET /api/v1/me shows a person their id.
TAILOR_USERS=
