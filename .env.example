# Copy to .env with `pnpm env:local`. In Kubernetes variables come from the ConfigMap
# <svc>-config and the SealedSecret <svc>-secrets (envFrom), not from a file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_VERSION=dev
# Port of the separate Prometheus listener (GET /metrics); 0 turns it off.
METRICS_PORT=9464
# Proxy hops in front of the service (0 locally, 1 behind one ingress); used for client IPs.
TRUST_PROXY_HOPS=0
# Delay before shutdown after SIGTERM so the load balancer drops the pod first (ms).
# 0 in Kubernetes: the pod's preStop sleep does that.
SHUTDOWN_DELAY_MS=0

# Secrets: no defaults in code. Values below match compose.yaml and are for local use only.
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_POOL_MAX=10

# Access tokens of id-api: its JWKS (in the cluster http://id-api.prod.svc/.well-known/jwks.json),
# issuer and audience. Locally: id-api's own port.
ID_JWKS_URL=http://localhost:4100/.well-known/jwks.json
TOKEN_ISSUER=http://localhost:3100
TOKEN_AUDIENCE=nick-lukashik

# tailor-tex, the internal CV renderer (in the cluster http://tailor-tex.prod.svc), and its
# INTERNAL_API_TOKEN (secret, 32+ characters). Without the token the master CV
# (GET /api/v1/profile/cv.pdf) answers 503. Locally: the tailor-tex image on :4021, e.g.
#   docker run -d -p 4021:3000 --read-only --tmpfs /tmp -e INTERNAL_API_TOKEN=<the value below> tailor-tex:local
# The value below is for local use only.
TAILOR_TEX_URL=http://localhost:4021
TAILOR_TEX_TOKEN=local-only-token-change-me-0123456789abcdef

# The platform LLM gateway (OpenAI-compatible; in the cluster http://llm-gateway.prod.svc), the client
# key of tailor-api there (secret, 32+ characters; a missing one stops the process at start) and the
# models that parse vacancies: model:effort:concurrency, comma-separated, one queue each. Locally: llm-gateway started with PORT=4030 and this key's hash in its
# LLM_CLIENTS (its scripts/client-key.mjs).
# The value below is for local use only.
LLM_GATEWAY_URL=http://localhost:4030
LLM_GATEWAY_KEY=llm-tailor-api-local-only-key-change-me-0123456789
LLM_PARSE_MODELS=claude-sonnet-5-5:low:3,gpt-6.1-sol:low:3

# Cloudflare R2 (its S3 API) for the CV files: the account endpoint and an API token's key pair
# (secrets, all three or none). Without them the service starts and a CV generation fails with
# storage_not_configured. Every key goes under R2_PREFIX in R2_BUCKET. Locally: any S3-compatible
# server, e.g. docker run -d -p 9090:9090 -e COM_ADOBE_TESTING_S3MOCK_STORE_INITIAL_BUCKETS=nl-files-prod adobe/s3mock:4.7.0
# The values below are for that local stand-in only (it does not check keys).
R2_ENDPOINT=http://localhost:9090
R2_ACCESS_KEY_ID=local-only
R2_SECRET_ACCESS_KEY=local-only
R2_BUCKET=nl-files-prod
R2_PREFIX=tailor/
